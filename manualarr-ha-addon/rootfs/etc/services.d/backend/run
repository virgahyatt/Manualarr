#!/usr/bin/with-contenv bashio
bashio::log.info "Starting Manualarr backend..."

# Set environment variables for HA add-on from options
export LOG_LEVEL=$(bashio::config 'log_level')
export MAX_SEARCH_RESULTS=$(bashio::config 'max_search_results')
export DATABASE_URL="sqlite:////data/manualarr.db"
export UPLOAD_DIR="/share/manualarr"

bashio::log.info "Log level: ${LOG_LEVEL}"
bashio::log.info "Max search results: ${MAX_SEARCH_RESULTS}"
bashio::log.info "Using database: ${DATABASE_URL}"
bashio::log.info "Using upload directory: ${UPLOAD_DIR}"

mkdir -p "${UPLOAD_DIR}"

cd /app/backend
exec uvicorn main:app --host 127.0.0.1 --port 8000
